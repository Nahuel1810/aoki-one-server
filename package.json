{
  "name": "aoki-one-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor modular para orquestacion de robots PLC por Modbus TCP",
  "main": "src/server.js",
  "type": "commonjs",
  "workspaces": [
    "packages/domain",
    "packages/agent",
    "packages/server"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:web": "cd packages/web && npm run dev",
    "build:web": "cd packages/web && npm run build",
    "postinstall": "cd packages/web && npm install",
    "test": "node --test tests/**/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.eslint.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:packages": "vitest run",
    "test:packages:watch": "vitest",
    "test:aceptacion": "vitest run --config vitest.aceptacion.mts",
    "test:aceptacion:watch": "vitest --config vitest.aceptacion.mts",
    "clean": "npm run clean --workspaces --if-present",
    "test:packages:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "ioredis": "^5.10.1",
    "modbus-serial": "^8.0.23",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
