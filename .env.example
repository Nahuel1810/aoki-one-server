HTTP_PORT=3000
QUEUE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_PREFIX=aok-one
PERSISTENCE_DRIVER=sqlite
SQLITE_DB_PATH=data/persistence.db
SIMULATE_PLC=false
ORCHESTRATOR_TICK_MS=300
HEARTBEAT_INTERVAL_MS=1000
HEARTBEAT_TIMEOUT_MS=3000
MAX_RETRIES_PER_STEP=3
BASE_BACKOFF_MS=200
COMMAND_ACK_TIMEOUT_MS=2000

# Polling Modbus para detectar respuesta del PLC (ms) y cantidad de intentos.
# Default historico era 2000/60. Bajado a 150/600 -> mismo techo (~90 s),
# menor latencia entre que el PLC responde y el server lo detecta.
STEP_ACK_INTERVAL_MS=150
STEP_ACK_MAX_ATTEMPTS=600
# Polling para verificar reset de messageOut tras un step exitoso.
# Default historico era 2500/60. Bajado a 150/600.
STEP_RESET_INTERVAL_MS=150
STEP_RESET_MAX_ATTEMPTS=600
MODBUS_RETRY_ATTEMPTS=3
MODBUS_RETRY_BACKOFF_MS=300
MODBUS_COMMAND_REGISTER=0
MODBUS_VERIFY_REGISTER=1
MODBUS_RESPONSE_REGISTER=2
