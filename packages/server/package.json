{
  "name": "@aoki-one/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor de pedidos: ingreso HMAC, cola durable y entrega al agente por long-poll",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@aoki-one/domain": "*"
  }
}
