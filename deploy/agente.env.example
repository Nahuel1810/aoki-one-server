# Entorno del agente de sucursal. Copiar a C:\aoki-one\agente.env
#
# El archivo tiene el SECRETO con el que esta sucursal firma contra el servidor:
# va con permisos solo para la cuenta que corre el servicio, y no entra al
# repositorio.

# --- Obligatorias -----------------------------------------------------------

# Identidad de la sucursal. Sale de la credencial que emite el servidor:
#   node packages/server/dist/herramientas/emitirCredencial.js --site-id SUC-CENTRO
AOKI_AGENT_SITE_ID=SUC-CENTRO

# Identidad de ESTA notebook dentro de la sucursal. No lo emite el servidor: se
# elige aca, y tiene que ser distinto en cada agente. Prefija el id externo de
# las ordenes manuales que se empujan al servidor (RF35), asi que dos agentes con
# el mismo valor generan ids que chocan en el libro del servidor.
AOKI_AGENT_ID=AG-1

# Base SQLite del agente, en el disco de esta notebook. Sin default a proposito:
# un default relativo al directorio de trabajo crea una base nueva cada vez que el
# servicio arranca desde otro lado, y con ella una sucursal sin historia.
AOKI_AGENT_RUTA_DE_BASE=C:\aoki-one\datos\agente.db

# Slots donde el robot deja lo que saca de la estanteria, separados por coma.
# Se validan uno por uno al arrancar: un codigo mal escrito deja ordenes
# esperando un lugar que no existe, y en planta se ve como "se colgo".
AOKI_AGENT_ZONA_DE_PICKEO=3X02AE1,3X02AC1,3X02AA1,3X01AE1,3X01AE2,3X01AE3,3X01AC1,3X01AC2,3X01AC3,3X01AA1,3X01AA2,3X01AA3

# --- El enlace con el servidor: o van las tres o no va ninguna ---------------
#
# VACIAS EN EL CUTOVER. La sucursal corre primero SOLA una jornada completa
# contra el robot real, con su cola local, y recien despues se enciende el
# enlace. Nunca las dos cosas el mismo dia.
#
# AOKI_AGENT_KEY_ID y AOKI_AGENT_SECRETO salen de la credencial que emitio el
# servidor, tal como la imprimio. El secreto se muestra UNA sola vez.
#
# Media configuracion (URL sin secreto) NO arranca: es un despliegue a medio
# terminar, y degradarlo a "enlace apagado" deja una sucursal que parece andar y
# no reporta nada.
AOKI_AGENT_SERVIDOR_URL=
AOKI_AGENT_KEY_ID=
AOKI_AGENT_SECRETO=

# --- Opcionales (estos son los defaults) ------------------------------------

# Puerto e interfaz de la API que consume la tablet.
#
# EL BIND NO VA EN 0.0.0.0. Toda la autorizacion del operario se apoya en estar
# en la LAN de la sucursal (RF22): no hay login, y estar en la red equivale a
# estar parado frente a la tablet. Con 0.0.0.0, cualquier otra interfaz de la
# notebook —el wifi de invitados, una VPN, un telefono compartiendo datos— pasa a
# ser tambien "estar frente a la tablet". Se escribe la IP de LAN, esa y nada mas.
AOKI_AGENT_HTTP_PUERTO=3000
AOKI_AGENT_HTTP_BIND=127.0.0.1

# true desmonta la API y el agente sigue ejecutando ordenes de su cola.
AOKI_AGENT_MONTAR_API=true

# PLC SIMULADO: contesta OK SIEMPRE sin mover el robot. Solo true|false, y solo
# para pruebas sin planta. En produccion va en false, que es el default.
AOKI_AGENT_SIMULAR_PLC=false

# Token del comando directo a PLC (RF22, segundo nivel). VACIO = el endpoint
# queda DESHABILITADO, y es el default. Es el unico endpoint que escribe
# registros salteandose el orquestador y las maquinas de estado.
AOKI_AGENT_TOKEN_DE_MANTENIMIENTO=

# Retencion del historico local, en dias, y cada cuanto corre la purga.
# La purga arranca con el agente y corre sola: en una notebook que nadie
# mantiene, una purga que depende de que alguien la ejecute es una purga que no
# existe.
AOKI_AGENT_RETENCION_EVENTOS_DIAS=30
AOKI_AGENT_RETENCION_PASOS_DIAS=14
AOKI_AGENT_PURGA_CADA_MINUTOS=60

# DEBUG | INFO | WARN | ERROR
# DEBUG incluye una linea por cada comando que sale al PLC —cinco por maniobra—:
# se sube solo para perseguir una orden concreta.
AOKI_AGENT_NIVEL_DE_LOG=INFO
