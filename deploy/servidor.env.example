# Entorno del servidor de pedidos. Copiar a /etc/aoki-one/servidor.env
#
#   install -d -m 0750 -o root -g aoki /etc/aoki-one
#   install -m 0640 -o root -g aoki servidor.env.example /etc/aoki-one/servidor.env
#
# El archivo tiene la clave con la que se descifran TODAS las credenciales de
# sucursal: va 0640 de root:aoki y no entra al repositorio.

# --- Obligatorias -----------------------------------------------------------

# Clave maestra de las credenciales de sucursal: 32 bytes en hexadecimal.
# Generar UNA vez con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# SI SE PIERDE, SE PIERDEN TODAS LAS CREDENCIALES. No hay forma de recuperar los
# secretos: hay que reemitir la credencial de cada sucursal y reconfigurar cada
# agente. Guardarla en el gestor de secretos ANTES de arrancar por primera vez.
AOKI_SERVER_CLAVE_DE_CREDENCIALES=

# Archivo SQLite del servidor. Tiene que estar en el directorio de estado del
# servicio, que es el unico donde la unidad puede escribir.
AOKI_SERVER_RUTA_DE_BASE=/var/lib/aoki-one/servidor.db

# --- Opcionales (estos son los defaults) ------------------------------------

# Puerto y interfaz. El default es loopback A PROPOSITO: el proxy que termina TLS
# es quien publica el servicio. Poner 0.0.0.0 aca expone HTTP plano a internet.
AOKI_SERVER_PUERTO=8080
AOKI_SERVER_BIND=127.0.0.1

# Retencion del historico de pedidos TERMINADOS, en dias. Lo que sigue abierto no
# se purga nunca, por viejo que sea.
AOKI_SERVER_RETENCION_DIAS=90

# Cada cuanto corre la purga, en minutos. Ademas corre una vez al arrancar.
AOKI_SERVER_PURGA_CADA_MINUTOS=360

# DEBUG | INFO | WARN | ERROR
AOKI_SERVER_NIVEL_DE_LOG=INFO
